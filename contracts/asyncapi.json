{
  "asyncapi": "3.0.0",
  "info": {
    "title": "DocSign Hub domain events",
    "version": "1.0.0",
    "description": "Catalog of domain events on the RabbitMQ topic exchange `docsign.events`.\n\n**Backend-emitted** events (`x-producer: backend`) are recorded by the Laravel core into the\ntransactional `outbox_messages` table in the same transaction and shipped by a publisher. Delivery is\nat-least-once and consumers dedup on `event_id` (carried as the AMQP `message_id`) via an inbox. Two\nconsumers bind to `document.*.v1`: **notifications** (sequential signing invitations and the expiry\nnotice) and **audit** (append-only MongoDB journal).\n\n**Platform-produced** events (`x-producer: <service>`) are emitted by polyglot services, not the PHP\noutbox — e.g. `signature.verified.v1` from the Go `signing-worker`. They share the same envelope and\ndedup rules. See `POLYGLOT_SERVICES.md`.\n\nPayloads carry no secrets or PII — signing tokens and participant emails never appear in an event. The\nmachine-checkable payload schemas live in `events/v1/*.schema.json` and are the single source of truth\n(backend events validated in `EventContractTest`); this document references them so it cannot drift\n(`AsyncApiCatalogTest`).",
    "license": { "name": "MIT" }
  },
  "servers": {
    "rabbitmq": {
      "host": "rabbitmq:5672",
      "protocol": "amqp",
      "description": "RabbitMQ broker. Durable topic exchange `docsign.events`; routing key `{event_type}.v{version}`."
    }
  },
  "defaultContentType": "application/json",
  "channels": {
    "documentCreated": {
      "address": "document.created.v1",
      "title": "document.created",
      "description": "A draft document was created.",
      "x-producer": "backend",
      "servers": [{ "$ref": "#/servers/rabbitmq" }],
      "bindings": { "amqp": { "is": "routingKey", "exchange": { "name": "docsign.events", "type": "topic", "durable": true } } },
      "messages": { "documentCreated": { "$ref": "#/components/messages/documentCreated" } }
    },
    "documentSent": {
      "address": "document.sent.v1",
      "title": "document.sent",
      "description": "A document was sent for signing. Triggers the first signing invitation (notifications consumer).",
      "x-producer": "backend",
      "servers": [{ "$ref": "#/servers/rabbitmq" }],
      "bindings": { "amqp": { "is": "routingKey", "exchange": { "name": "docsign.events", "type": "topic", "durable": true } } },
      "messages": { "documentSent": { "$ref": "#/components/messages/documentSent" } }
    },
    "documentSigned": {
      "address": "document.signed.v1",
      "title": "document.signed",
      "description": "A party signed. Triggers the next signer's invitation while the document is still open (notifications consumer); also consumed by the Go signing-worker for verification.",
      "x-producer": "backend",
      "servers": [{ "$ref": "#/servers/rabbitmq" }],
      "bindings": { "amqp": { "is": "routingKey", "exchange": { "name": "docsign.events", "type": "topic", "durable": true } } },
      "messages": { "documentSigned": { "$ref": "#/components/messages/documentSigned" } }
    },
    "documentCompleted": {
      "address": "document.completed.v1",
      "title": "document.completed",
      "description": "All signers signed; the envelope is complete.",
      "x-producer": "backend",
      "servers": [{ "$ref": "#/servers/rabbitmq" }],
      "bindings": { "amqp": { "is": "routingKey", "exchange": { "name": "docsign.events", "type": "topic", "durable": true } } },
      "messages": { "documentCompleted": { "$ref": "#/components/messages/documentCompleted" } }
    },
    "documentCancelled": {
      "address": "document.cancelled.v1",
      "title": "document.cancelled",
      "description": "The owner cancelled the document.",
      "x-producer": "backend",
      "servers": [{ "$ref": "#/servers/rabbitmq" }],
      "bindings": { "amqp": { "is": "routingKey", "exchange": { "name": "docsign.events", "type": "topic", "durable": true } } },
      "messages": { "documentCancelled": { "$ref": "#/components/messages/documentCancelled" } }
    },
    "documentExpired": {
      "address": "document.expired.v1",
      "title": "document.expired",
      "description": "The signing deadline passed before completion. Triggers the expiry notice to the owner (notifications consumer).",
      "x-producer": "backend",
      "servers": [{ "$ref": "#/servers/rabbitmq" }],
      "bindings": { "amqp": { "is": "routingKey", "exchange": { "name": "docsign.events", "type": "topic", "durable": true } } },
      "messages": { "documentExpired": { "$ref": "#/components/messages/documentExpired" } }
    },
    "signatureVerified": {
      "address": "signature.verified.v1",
      "title": "signature.verified",
      "description": "The Go signing-worker re-checked a signature's content_hash/signature_hash and reports the result. Document-scoped (aggregate = document); data carries the signature id and the verdict.",
      "x-producer": "signing-worker",
      "servers": [{ "$ref": "#/servers/rabbitmq" }],
      "bindings": { "amqp": { "is": "routingKey", "exchange": { "name": "docsign.events", "type": "topic", "durable": true } } },
      "messages": { "signatureVerified": { "$ref": "#/components/messages/signatureVerified" } }
    }
  },
  "operations": {
    "publishDocumentCreated": {
      "action": "send",
      "channel": { "$ref": "#/channels/documentCreated" },
      "summary": "Publish document.created."
    },
    "publishDocumentSent": {
      "action": "send",
      "channel": { "$ref": "#/channels/documentSent" },
      "summary": "Publish document.sent."
    },
    "publishDocumentSigned": {
      "action": "send",
      "channel": { "$ref": "#/channels/documentSigned" },
      "summary": "Publish document.signed."
    },
    "publishDocumentCompleted": {
      "action": "send",
      "channel": { "$ref": "#/channels/documentCompleted" },
      "summary": "Publish document.completed."
    },
    "publishDocumentCancelled": {
      "action": "send",
      "channel": { "$ref": "#/channels/documentCancelled" },
      "summary": "Publish document.cancelled."
    },
    "publishDocumentExpired": {
      "action": "send",
      "channel": { "$ref": "#/channels/documentExpired" },
      "summary": "Publish document.expired."
    },
    "publishSignatureVerified": {
      "action": "send",
      "channel": { "$ref": "#/channels/signatureVerified" },
      "summary": "Publish signature.verified (emitted by the Go signing-worker)."
    }
  },
  "components": {
    "messages": {
      "documentCreated": {
        "name": "document.created",
        "title": "Document created",
        "contentType": "application/json",
        "payload": { "schemaFormat": "application/schema+json;version=draft-07", "schema": { "$ref": "./events/v1/document.created.schema.json" } }
      },
      "documentSent": {
        "name": "document.sent",
        "title": "Document sent",
        "contentType": "application/json",
        "payload": { "schemaFormat": "application/schema+json;version=draft-07", "schema": { "$ref": "./events/v1/document.sent.schema.json" } }
      },
      "documentSigned": {
        "name": "document.signed",
        "title": "Document signed",
        "contentType": "application/json",
        "payload": { "schemaFormat": "application/schema+json;version=draft-07", "schema": { "$ref": "./events/v1/document.signed.schema.json" } }
      },
      "documentCompleted": {
        "name": "document.completed",
        "title": "Document completed",
        "contentType": "application/json",
        "payload": { "schemaFormat": "application/schema+json;version=draft-07", "schema": { "$ref": "./events/v1/document.completed.schema.json" } }
      },
      "documentCancelled": {
        "name": "document.cancelled",
        "title": "Document cancelled",
        "contentType": "application/json",
        "payload": { "schemaFormat": "application/schema+json;version=draft-07", "schema": { "$ref": "./events/v1/document.cancelled.schema.json" } }
      },
      "documentExpired": {
        "name": "document.expired",
        "title": "Document expired",
        "contentType": "application/json",
        "payload": { "schemaFormat": "application/schema+json;version=draft-07", "schema": { "$ref": "./events/v1/document.expired.schema.json" } }
      },
      "signatureVerified": {
        "name": "signature.verified",
        "title": "Signature verified",
        "contentType": "application/json",
        "payload": { "schemaFormat": "application/schema+json;version=draft-07", "schema": { "$ref": "./events/v1/signature.verified.schema.json" } }
      }
    }
  }
}
