{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "signature.verified.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "routing_key", "version", "occurred_at", "aggregate_type", "aggregate_id", "actor_id", "data"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": { "const": "signature.verified" },
    "routing_key": { "const": "signature.verified.v1" },
    "version": { "const": 1 },
    "occurred_at": { "type": "string", "minLength": 1 },
    "aggregate_type": { "const": "document" },
    "aggregate_id": { "type": "string", "minLength": 1 },
    "actor_id": { "type": ["integer", "null"] },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature_id", "party_id", "valid", "checked_at"],
      "properties": {
        "signature_id": { "type": "integer" },
        "party_id": { "type": "integer" },
        "valid": { "type": "boolean" },
        "checked_at": { "type": "string", "minLength": 1 }
      }
    }
  }
}
