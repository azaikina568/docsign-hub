APP_NAME="DocSign Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

API_PORT=8080
FRONTEND_PORT=3000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=docsign_hub
DB_USERNAME=docsign
DB_PASSWORD=docsign

CACHE_STORE=redis
QUEUE_CONNECTION=database
SESSION_DRIVER=file

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=docsign
RABBITMQ_PASSWORD=docsign
RABBITMQ_EXCHANGE=docsign.events

MONGODB_URI=mongodb://docsign:docsign@mongodb:27017/docsign_hub?authSource=admin
MONGODB_DATABASE=docsign_hub

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@docsign-hub.local
MAIL_FROM_NAME="${APP_NAME}"

DOCSIGN_SIGNING_TOKEN_TTL_DAYS=14
DOCSIGN_SIGNING_URL_BASE="${APP_URL}/sign"

VITE_API_BASE_URL=http://localhost:8080/api/v1
