APP_NAME="DocSign Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# URL фронтенда (SPA): на него ведут ссылки в письмах (подписание, и т.п.).
# Docker-compose поднимает фронт на 3000; локальный `npm run dev` по умолчанию на 5173.
FRONTEND_URL=http://localhost:3000
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

API_PORT=8080
FRONTEND_PORT=3000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=docsign_hub
DB_USERNAME=docsign
DB_PASSWORD=docsign

CACHE_STORE=redis
QUEUE_CONNECTION=database
SESSION_DRIVER=file

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=docsign
RABBITMQ_PASSWORD=docsign
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=docsign.events

MONGODB_URI=mongodb://docsign:docsign@mongodb:27017/docsign_hub?authSource=admin
MONGODB_DATABASE=docsign_hub

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@docsign-hub.local
MAIL_FROM_NAME="${APP_NAME}"

DOCSIGN_SIGNING_TOKEN_TTL_DAYS=14
DOCSIGN_SIGNING_URL_BASE="${FRONTEND_URL}/signing"

# Сроки жизни токенов (минуты): короткий access, долгий refresh (по умолчанию 30 дней).
AUTH_ACCESS_TOKEN_TTL=60
AUTH_REFRESH_TOKEN_TTL=43200

# Опциональный тюнинг очередей/outbox (значения = дефолты из config/messaging.php; раскомментировать при нужде).
# MESSAGING_RETENTION_DAYS=7        # окно чистки доставленных outbox/inbox строк (messaging:prune)
# OUTBOX_PUBLISH_BATCH=100          # размер батча публикации за проход
# OUTBOX_MAX_ATTEMPTS=8             # попыток публикации до перевода строки в failed

VITE_API_BASE_URL=http://localhost:8080/api/v1
