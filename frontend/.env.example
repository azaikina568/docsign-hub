# Базовый URL API (с версией). Локально бэкенд поднимается на 8080 через docker compose.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Polling для Vite HMR. На хосте не нужен (нативный watch); в Docker на Windows его выставляет
# docker-compose ("true"), т.к. bind-mount не отдаёт file-события. Читается из process.env в vite.config.
VITE_USE_POLLING=false
